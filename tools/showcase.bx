// tools/showcase.bx — The landing page's showcase: one document becoming a whole page, with a slider over its two halves.
//
//     burxt build tools/render.bx -o bmxrender
//     burxt build tools/showcase.bx -o showcase && ./showcase   # -> ../docs/_includes/showcase.html
//
// **Ported from `tools/showcase.py` and byte-identical to it**, verified against the committed
// `docs/_includes/showcase.html` and then against a planted difference, because a byte comparison that
// agrees proves nothing until it has been seen to disagree.
//
// The landing page's showcase: one document becoming a whole page, with a slider over its two halves.
//
//     burxt build render.bx -o bmxrender
//     python3 showcase.py        # -> ../docs/_includes/showcase.html
//
// **Live HTML rather than a screenshot**, and that is the whole reason it exists: a picture cannot be
// checked and a rendered page can. Everything inside the browser frame is real `bmxrender` output from
// `shop.bmx`, injected at generation time. Hand-written HTML pretending to be renderer output is the same
// defect as a spec sentence nobody ran.
//
// **One document, and no HTML anywhere — which took Andre asking twice to get right.**
//
// The first two versions showed a `.bmx` beside a `layout.html`, on the theory that BMX cannot express a
// navigation bar and a host template has to supply it. Then he asked *"you really need html?"*, and the
// measurement said no:
//
//     # Roast&Co            ->   <h1>Roast&amp;Co</h1>
//     - [Coffee](/coffee)   ->   <ul><li><a href="/coffee">Coffee</a></li> ...
//
// A bar is a brand and a row of links, and BMX renders both today. What BMX has no syntax for is
// *attributes* — so the stylesheet selects structurally (`.bmx > h1` is the brand, `.bmx > p:first-of-type`
// is the link row) instead of by class. That is the real boundary, and it is far narrower than the one I
// had asserted in two captions. The honest caveat, which the page states rather than hides: a positional
// selector is brittle, and `:nav:` is the fix — a block names the region, and a host that declares `nav`
// renders it however it likes. `bmxrender` refuses blocks by design (`BMX-R003`), which is why this page
// does not use one, and it is exactly the hook a framework builds on.
//
// So the slider is over halves of ONE document rather than over two files: **the bar**, **the content**,
// and the whole page. The result blurs — Andre's idea, and better than a caption, because the whole page
// stays on screen and a reader sees *where* the split falls instead of reading about it.
//
// **Four rules this file follows, each because the alternative has already gone wrong here:**
//
// *The source panel is the file that was rendered*, read at generation time. A panel retyped by hand can
// disagree with the output above it and the picture would still look right.
//
// *The line count in the prose is counted, not typed.* An earlier version said "nine lines" of a file that
// is eleven, with all eleven of them visible directly beneath the sentence.
//
// *The slider is CSS only.* Radio inputs and sibling selectors, no JavaScript — the site's `.picker`
// styling exists but its behaviour lived in a page-local script on another site, and a showcase that needs
// a script is a showcase that is blank when the script does not load.
//
// *The panel is marked `language-bmx` so `code.js` colours it*, rather than this file shipping a second
// colouriser. `code.js` selects `pre > code.language-bmx`; emitting that markup is the whole integration.
use "std/files.bx";
use "std/html.bx";
use "std/os.bx";
use "std/string.bx";

let SHOWCASE: String = "<!-- GENERATED by tools/showcase.py from tools/shop.bmx. Do not edit: regenerate. -->\n<div class=\"showcase\">\n  <input type=\"radio\" name=\"showcase\" id=\"sc-bar\">\n  <input type=\"radio\" name=\"showcase\" id=\"sc-body\">\n  <input type=\"radio\" name=\"showcase\" id=\"sc-all\" checked>\n\n  <fieldset class=\"picker\">\n    <legend>What this shows</legend>\n    <label for=\"sc-bar\">The bar</label>\n    <label for=\"sc-body\">The content</label>\n    <label for=\"sc-all\">The whole page</label>\n  </fieldset>\n\n  <div class=\"win\">\n    <div class=\"chrome\">\n      <span class=\"dot r\"></span><span class=\"dot y\"></span><span class=\"dot g\"></span>\n      <span class=\"url\">roastandco.example/shop</span>\n    </div>\n__BODY__\n  </div>\n\n  <figure class=\"src\">\n    <figcaption>shop.bmx <span>the whole page, and the only file</span></figcaption>\n    <pre><code class=\"language-bmx\">__SOURCE__</code></pre>\n  </figure>\n\n  <p class=\"showcase-note bar-note\">The bar is <strong>the heading and the row of links</strong> — the\n  first two lines of the document. BMX has no attribute syntax, so the stylesheet reaches them by\n  position rather than by class: <code>.bmx &gt; h1</code> is the brand, the first <code>p</code> is the\n  links. Brittle on purpose, to show where the seam is — <code>:nav:</code> is how you name the region\n  instead, and your framework decides what it renders as.</p>\n  <p class=\"showcase-note body-note\">The content is markdown doing what markdown does: a heading, a\n  paragraph, a list, a quote, a link. The cards are list items and the thumbnails are CSS gradients —\n  BMX has no image syntax (<code>SPEC.md</code> §7).</p>\n  <p class=\"showcase-note all-note\">One document, __DOC_LINES__ lines, and <strong>no HTML\n  anywhere</strong> — the bar, the search box, the buttons, the cards, the quote, the price. A document\n  and a stylesheet, which is what every page has.</p>\n</div>\n";

let rendered: Capture = os_capture_status("./bmxrender shop.bmx");
let body: String = string_trim(rendered.output);

match file_read_maybe("shop.bmx") {
    None => {
        print_error("cannot read shop.bmx");
        exit(2);
    }
    Some(raw) => {
        let doc_src: String = string_trim_end(raw);
        let source: String = html_escape(doc_src);
        // Counted rather than typed, because the panel showing every line sits directly beneath the
        // sentence claiming how many there are.
        let doc_lines: String = to_string(len(string_lines(doc_src)));
        let mutable page: String = string_replace(SHOWCASE, "__BODY__", body);
        page = string_replace(page, "__SOURCE__", source);
        page = string_replace(page, "__DOC_LINES__", doc_lines);
        let wrote: Int = file_write("../docs/_includes/showcase.html", page);
        print("wrote docs/_includes/showcase.html");
    }
}
